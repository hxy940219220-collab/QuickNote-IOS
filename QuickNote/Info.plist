<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>QuickNote</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>仅在你点击录音时使用麦克风，将口述内容在本机转为便签文字；录音不会上传或保存。</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>QuickNote 需要截取你主动选择的屏幕区域，用于图片分析。</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>用 QuickNote 识图</string>
			</dict>
			<key>NSMessage</key>
			<string>analyzeImage</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.image</string>
				<string>public.file-url</string>
			</array>
		</dict>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>将你主动录制的中文语音在本机转成可编辑文字，确认后再写入便签。</string>
</dict>
</plist>
